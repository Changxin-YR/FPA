# ============================================================================
# 渔芯 环境变量模板
# 复制为 .env 后填写真实值。.env 已在 .gitignore 中，绝不入库。
# ============================================================================

# --- 运行环境 ---
APP_ENV=development
SECRET_KEY=dev-only-change-me

# --- MySQL ---
# 本地开发：按你的 MySQL 实例填写
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yuxin
MYSQL_USER=yuxin
MYSQL_PASSWORD=change-me

# --- 会话 ---
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- CORS（跨源调试时填，逗号分隔）---
YUXIN_CORS_ORIGINS=

# --- 前端 ---
VITE_PUBLIC_BASE_PATH=/
VITE_API_BASE_URL=

# ============================================================================
# DeepSeek Harness 集成
# ============================================================================

# Harness 运行时 home（必须显式指定，SDK 刻意不发现 ~/.dsh）
AGENT_DSH_HOME=./.dsh-home

# dsh 可执行文件；留空时用 PATH 上的 `dsh`
AGENT_DSH_BIN=

# Harness 运行时安装根目录；从源码运行时用它解析 profile，装好的发行版可留空
AGENT_HARNESS_ROOT=

# 模型路由
AGENT_MODEL_PROVIDER=deepseek-official
AGENT_MODEL=deepseek-v4-flash
AGENT_MAX_TOKENS=32768

# 单轮超时（秒）。多次工具调用可能需要 60-90s。
AGENT_REQUEST_TIMEOUT_SECONDS=90

# 子进程池容量。早期版本用一把全局锁罩住整个 run()，
# 配合 gunicorn --workers 2 --threads 2 导致每 worker 同时只能跑 1 个回合。
AGENT_POOL_SIZE=4

# 上下文令牌有效期（秒）。绑定 user/session/conversation；到期会重建 Harness 会话。
AGENT_CONTEXT_TTL_SECONDS=1800

# 人工确认令牌有效期（秒）
AGENT_CONFIRMATION_TTL_SECONDS=300

# ============================================================================
# 测试前置：Agent HTTP 契约
# ============================================================================
# `tests/test_agent_http_contract.py` 有一条「低权限账号的权限拒绝路径」用例，需要
# 一个真实存在、且没有 `pond.create` 权限的账号（用来证明工具清单会过滤、越权调用被 403）。
# 不填这两个变量，该用例会 skip —— 那条拒绝路径也就没被执行。
YUXIN_LOW_PRIV_USER=
YUXIN_LOW_PRIV_PASSWORD=

